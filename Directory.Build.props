<Project>

  <PropertyGroup>
    <!--
      The library targets .NET 10. Override on the command line to build and test
      against an older SDK, e.g. `dotnet build -p:SpsTargetFramework=net9.0`.
      No source in this repository depends on .NET 10-only APIs.
    -->
    <SpsTargetFramework Condition="'$(SpsTargetFramework)' == ''">net10.0</SpsTargetFramework>
    <TargetFramework>$(SpsTargetFramework)</TargetFramework>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
