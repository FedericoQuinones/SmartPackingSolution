<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SmartPackingSolution</PackageId>
    <Version>2.0.0</Version>
    <Authors>Federico Quiñones</Authors>
    <Description>A 3D bin packing library for .NET that produces physically valid container layouts: gravity-aware support, per-item load bearing, all six box orientations, and multiple packing strategies.</Description>
    <PackageTags>bin-packing;3d;logistics;optimization;containers;shipping</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/FedericoQuinones/SmartPackingSolution</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
